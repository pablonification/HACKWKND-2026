# =========================
# Supabase
# =========================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VITE_PASSWORD_RESET_REDIRECT_TO=https://your-domain.com/reset-password

# =========================
# AI Backend
# =========================
VITE_AI_BASE_URL=http://localhost:8787
OMNIASR_BASE_URL=https://pablonification-omniasr-transcriptions.hf.space
OMNIASR_LANGUAGE=sea_Latn
OMNIASR_TIMEOUT_MS=120000

# =========================
# Capacitor Dev Server
# =========================
CAPACITOR_DEV_SERVER_URL=http://your-local-ip:5173

# =========================
# ElevenLabs (Text to Speech)
# =========================
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# =========================
# AI Providers
# =========================
AI_COACH_PROVIDER_ORDER=claude-agent,gemini
AI_COACH_CLAUDE_AGENT_BASE_URL=https://your-claude-agent-gateway.example.com/v1
AI_COACH_CLAUDE_AGENT_API_KEY=your-taleka-claude-agent-gateway-key
AI_COACH_CLAUDE_AGENT_MODEL=sonnet
GOOGLE_AI_STUDIO_API_KEY=your-google-ai-studio-api-key
AI_COACH_GEMINI_MODEL=gemini-3.1-flash-lite-preview
AI_COACH_TIMEOUT_MS=12000
AI_COACH_PROVIDER_RETRY_COUNT=1
AI_COACH_PROVIDER_RETRY_DELAY_MS=900

# =========================
# Local Claude Agent SDK Gateway (demo laptop only)
# =========================
TALEKA_CLAUDE_AGENT_KEY=your-taleka-claude-agent-gateway-key
TALEKA_CLAUDE_AGENT_HOST=127.0.0.1
TALEKA_CLAUDE_AGENT_PORT=10535
TALEKA_CLAUDE_AGENT_MODEL=sonnet
TALEKA_CLAUDE_AGENT_MAX_BYTES=1048576
TALEKA_CLAUDE_AGENT_TIMEOUT_MS=45000
TALEKA_CLAUDE_AGENT_RETRY_COUNT=2
TALEKA_CLAUDE_AGENT_RETRY_DELAY_MS=900

# =========================
# Local ChatGPT Proxy Gateway (legacy demo fallback only)
# =========================
TALEKA_DEMO_PROXY_KEY=your-taleka-demo-proxy-key
TALEKA_DEMO_GATEWAY_HOST=127.0.0.1
TALEKA_DEMO_GATEWAY_PORT=10532
TALEKA_DEMO_PROXY_TARGET=http://127.0.0.1:10531
TALEKA_DEMO_PROXY_MAX_BYTES=1048576

# =========================
# Cerebras (optional)
# =========================
#CEREBRAS_API_KEY=your-cerebras-api-key
#CEREBRAS_MODEL=zai-glm-4.7
#CEREBRAS_FALLBACK_MODEL=

